[Unit]
Description=Financial Snapshot Webhook Server
After=network.target

[Service]
User=eparker
WorkingDirectory=/home/eparker/applications/financial-snapshot
EnvironmentFile=/home/eparker/applications/financial-snapshot/.env
ExecStart=/home/eparker/applications/financial-snapshot/venv/bin/gunicorn \
    --workers 2 \
    --bind 127.0.0.1:5000 \
    --access-logfile /home/eparker/applications/financial-snapshot/logs/gunicorn-access.log \
    --error-logfile /home/eparker/applications/financial-snapshot/logs/gunicorn-error.log \
    webhook_server:app
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
